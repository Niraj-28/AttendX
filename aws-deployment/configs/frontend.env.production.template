# AttendX Frontend - Production Environment Variables
# Copy this to frontend/.env and fill in your actual values

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
# Point to your EC2 backend API
VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP/api

# Alternative: If using custom domain for backend
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
VITE_APP_NAME=AttendX
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# ==============================================================================
# FEATURE FLAGS (Optional)
# ==============================================================================
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_FACE_RECOGNITION=true
VITE_ENABLE_REPORTS=true

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Vite only exposes variables prefixed with VITE_
# 2. Rebuild frontend after changing these values: npm run build
# 3. Upload new build to S3: aws s3 sync dist/ s3://bucket-name/
# 4. Invalidate CloudFront cache if using CDN
