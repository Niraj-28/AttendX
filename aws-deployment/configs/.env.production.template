# AttendX Backend - Production Environment Variables
# Copy this to backend/.env and fill in your actual values

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5001
NODE_ENV=production

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG
JWT_EXPIRES_IN=24h

# ==============================================================================
# AWS CONFIGURATION
# ==============================================================================
AWS_REGION=us-east-1

# Option 1: Use IAM Role (Recommended for EC2 - more secure)
# No need to set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# Just attach IAM role to EC2 instance with S3 and SNS permissions

# Option 2: Use Access Keys (if IAM role not available)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=wJalrXUtn...

# ==============================================================================
# S3 CONFIGURATION
# ==============================================================================
S3_BUCKET_NAME=attendx-images-YOUR-INITIALS-2026
S3_STUDENT_PHOTOS_PREFIX=students/
S3_ATTENDANCE_IMAGES_PREFIX=attendance/

# ==============================================================================
# RDS MYSQL CONFIGURATION
# ==============================================================================
DB_HOST=attendx-db.xxxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=YOUR_RDS_PASSWORD_HERE
DB_NAME=attendx

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ==============================================================================
# SNS CONFIGURATION (Optional - for notifications)
# ==============================================================================
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:attendx-notifications

# ==============================================================================
# PYTHON CONFIGURATION
# ==============================================================================
PYTHON_EXECUTABLE=python3
FACE_RECOGNITION_SCRIPT=./python/face_recognition_service.py

# ==============================================================================
# FRONTEND URL (for CORS)
# ==============================================================================
# Option 1: S3 Static Website
FRONTEND_URL=http://attendx-frontend-YOUR-INITIALS-2026.s3-website-us-east-1.amazonaws.com

# Option 2: CloudFront (if configured)
# FRONTEND_URL=https://d111111abcdef8.cloudfront.net

# Option 3: Custom Domain (if configured)
# FRONTEND_URL=https://attendx.yourdomain.com

# ==============================================================================
# STORAGE MODE
# ==============================================================================
USE_AWS=true
USE_LOCAL_STORAGE=false

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_TO_FILE=true

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# SESSION CONFIGURATION
# ==============================================================================
SESSION_TIMEOUT_MINUTES=30

# ==============================================================================
# FILE UPLOAD LIMITS
# ==============================================================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# ==============================================================================
# FACE RECOGNITION SETTINGS
# ==============================================================================
FACE_RECOGNITION_TOLERANCE=0.6  # Lower = stricter (0.0-1.0)
FACE_DETECTION_MODEL=hog  # Options: hog (faster), cnn (more accurate)

# ==============================================================================
# SECURITY
# ==============================================================================
BCRYPT_ROUNDS=10
ENABLE_CORS=true
TRUST_PROXY=true

# ==============================================================================
# MONITORING (Optional)
# ==============================================================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# NEW_RELIC_LICENSE_KEY=xxxxx

# ==============================================================================
# NOTES
# ==============================================================================
# 1. NEVER commit this file to version control
# 2. Keep a backup in a secure location
# 3. Use strong passwords (min 16 characters)
# 4. Generate new JWT_SECRET for each environment
# 5. Restrict database access to EC2 security group only
